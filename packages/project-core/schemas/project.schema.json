{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-prototype-platform.local/schemas/project.schema.json",
  "title": "Project prototype package",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "pageDefinitions", "clients", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "defaultLocale": { "type": "string", "default": "zh-CN" },
    "pageDefinitions": { "const": "page-definitions.js" },
    "homepage": {
      "type": "object",
      "properties": { "visible": { "type": "boolean" } },
      "additionalProperties": true
    },
    "branding": {
      "type": "object",
      "properties": {
        "logo": { "$ref": "#/$defs/relativePath" },
        "favicon": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary": { "$ref": "#/$defs/color" },
        "primaryHover": { "$ref": "#/$defs/color" },
        "primaryActive": { "$ref": "#/$defs/color" },
        "pageBackground": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": false
    },
    "clients": {
      "type": "array",
      "items": { "$ref": "#/$defs/client" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "docs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "prototype": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "root": { "type": "string" },
        "client": { "type": "string" },
        "section": { "type": "string" },
        "clients": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/prototypeSource" }
            },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/prototypeSource" }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "mobile": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "entry": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "features": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "compatibility": {
      "type": "object",
      "properties": {
        "legacyRoutes": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[a-zA-Z]:[\\\\/]|/|.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))" }
    },
    "client": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "defaultPage": { "type": "string" },
        "entry": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["direct", "platform-login", "custom-page"] },
            "page": { "type": "string" }
          },
          "additionalProperties": true
        },
        "layout": {
          "type": "object",
          "properties": { "type": { "enum": ["sidebar", "topnav", "none", "bare"] } },
          "additionalProperties": true
        },
        "login": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["client", "docs", "mobile"] },
        "clientId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "additionalProperties": true
    },
    "prototypeSource": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "clientId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1 },
        "section": { "type": "string" },
        "icon": { "type": "string" },
        "shellMode": { "enum": ["auto", "full"] }
      },
      "additionalProperties": true
    }
  }
}
