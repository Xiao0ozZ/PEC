{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-prototype-platform.local/schemas/page-definitions.schema.json",
  "title": "Client page definitions",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["sections", "pages"],
    "properties": {
      "basePath": { "type": "string" },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "title": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "pages": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["path", "name", "title", "sourceType", "source", "section"],
          "properties": {
            "path": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "name": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "sourceType": { "enum": ["html-direct", "html-template"] },
            "source": { "type": "string", "pattern": "^[^/\\\\].*\\.html?$" },
            "section": { "type": "string" },
            "icon": { "type": "string" },
            "menu": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      }
    },
    "additionalProperties": true
  }
}
